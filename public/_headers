# Always revalidate the shell so Private/Safari don't stick on an old
# empty-config build after a deploy. no-store — edge was still HIT on no-cache.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/sw.js
  Cache-Control: no-store

# iOS universal links: Apple fetches this without an extension and wants JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
