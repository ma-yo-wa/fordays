# Copy to .env for local dev. On Cloudflare Pages, set the same names
# under Settings → Environment variables (Production).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar (OAuth Web client ID).
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Outlook / Microsoft Graph (SPA app, not a secret). Redirect URI must be
# exactly this origin, e.g. https://fordays.app/ and http://localhost:5173/
# VITE_MS_CLIENT_ID=
# VITE_VAPID_PUBLIC_KEY=
# VITE_GIPHY_API_KEY=   # GIFs — free at developers.giphy.com
# VITE_GIPHY_USE_FUNCTION=1  # only after: supabase functions deploy giphy
# VITE_UNSPLASH_ACCESS_KEY=  # stills — free at unsplash.com/developers

# Server-side keys for the Edge Functions (iOS uses these). They live in
# `supabase secrets`, not in this file:
#   GIPHY_API_KEY          — set 2026-09-26; `giphy` deployed
#   UNSPLASH_ACCESS_KEY=   — placeholder: `unsplash` is deployed but answers
#                            "not_configured" until you run
#                            supabase secrets set UNSPLASH_ACCESS_KEY=...
